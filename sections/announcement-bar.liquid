{%- if section.settings.show_announcement -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    {%- if section.settings.announcement_link != blank -%}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement_text }}</a>
    {%- else -%}
      <p style="margin:0;">{{ section.settings.announcement_text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de Anúncios",
  "class": "announcement-bar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "default": true,
      "label": "Mostrar barra de anúncios"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "default": "Frete grátis em pedidos acima de R$250 • Use o cupom BEM-VINDO10 e ganhe 10% de desconto",
      "label": "Texto do anúncio"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Link do anúncio"
    }
  ],
  "presets": [
    {
      "name": "Barra de Anúncios"
    }
  ]
}
{% endschema %}
