<section class="section" style="padding:0">
  <div class="page-width">
    <div class="trust-bar">
      {%- for block in section.blocks -%}
        <div class="trust-badge" {{ block.shopify_attributes }}>
          <div class="trust-badge__icon">{{ block.settings.icon }}</div>
          <div class="trust-badge__title">{{ block.settings.title }}</div>
          <p class="trust-badge__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Barra de Confianza",
  "tag": "section",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Icono",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "default": "🚚",
          "label": "Emoji / Icono"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Free Shipping",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Orders over €50",
          "label": "Texto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de Confianza",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🚚", "title": "Free Shipping", "text": "Orders over €50" } },
        { "type": "badge", "settings": { "icon": "💳", "title": "Pay in Installments", "text": "Interest-free" } },
        { "type": "badge", "settings": { "icon": "🔄", "title": "Easy Returns", "text": "30 days to return" } },
        { "type": "badge", "settings": { "icon": "🔒", "title": "Secure Shopping", "text": "100% protected website" } }
      ]
    }
  ]
}
{% endschema %}
