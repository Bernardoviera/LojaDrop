<section class="section">
  <div class="page-width">
    <h1 style="margin-bottom:4rem">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page">
        <div class="cart-items">
          <div class="cart-items-header">
            <span>{{ 'sections.cart.product' | t }}</span>
            <span>{{ 'sections.cart.quantity' | t }}</span>
            <span>{{ 'sections.cart.total' | t }}</span>
          </div>

          {%- for item in cart.items -%}
            <div class="cart-item" id="cart-item-{{ item.key | replace: ':', '-' }}">
              <div class="cart-item__media">
                <a href="{{ item.url }}">
                  {{
                    item.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', width: 200, alt: item.title
                  }}
                </a>
              </div>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-item__price">
                  {%- render 'price', product: item.product, variant: item.variant -%}
                </div>
                <div class="quantity-selector" style="margin-top:0.8rem">
                  <button type="button" class="quantity-btn" data-cart-action="decrease" data-cart-key="{{ item.key }}" aria-label="{{ 'sections.cart.decrease_quantity' | t }}">−</button>
                  <input class="quantity-input" type="number" value="{{ item.quantity }}" min="1" aria-label="{{ 'cart.item_quantity' | t }}">
                  <button type="button" class="quantity-btn" data-cart-action="increase" data-cart-key="{{ item.key }}" aria-label="{{ 'sections.cart.increase_quantity' | t }}">+</button>
                </div>
                <button type="button" class="cart-item__remove" data-cart-remove="{{ item.key }}">{{ 'general.remove' | t }}</button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Summary -->
        <div class="cart-summary">
          <h2 class="cart-summary__title">{{ 'sections.cart.order_summary' | t }}</h2>

          <div class="cart-summary__row">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span data-cart-total>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span>{{ 'sections.cart.shipping' | t }}</span>
            <span>{{ 'sections.cart.calculated_at_checkout' | t }}</span>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>{{ 'sections.cart.total' | t }}</span>
            <span data-cart-total>{{ cart.total_price | money }}</span>
          </div>

          <p class="cart-summary__note">
            {{ 'sections.cart.taxes' | t }}
          </p>

          <a href="/checkout" class="btn btn--primary btn--full">
            {{ 'sections.cart.checkout' | t }}
          </a>

          <div style="text-align:center;margin-top:1.6rem">
            <a href="{{ routes.root_url }}" style="font-size:1.4rem;text-decoration:underline;color:rgba(var(--color-base-text),0.6)">
              {{ 'sections.cart.continue_shopping' | t }}
            </a>
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <h2 class="cart-empty__title">{{ 'sections.cart.empty' | t }}</h2>
        <p class="cart-empty__text">{{ 'sections.cart.empty_text' | t }}</p>
        <a href="{{ routes.root_url }}" class="btn btn--primary">{{ 'sections.cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var cartItemsEl = document.querySelector('.cart-items');
  if (!cartItemsEl) return;

  cartItemsEl.addEventListener('click', function (e) {
    var actionBtn = e.target.closest('[data-cart-action]');
    var removeBtn = e.target.closest('[data-cart-remove]');

    if (actionBtn) {
      var itemEl = actionBtn.closest('.cart-item');
      var input  = itemEl && itemEl.querySelector('.quantity-input');
      var qty    = input ? (parseInt(input.value) || 1) : 1;
      var newQty = actionBtn.dataset.cartAction === 'increase' ? qty + 1 : Math.max(0, qty - 1);
      cartPageUpdate(actionBtn.dataset.cartKey, newQty, itemEl);
    }

    if (removeBtn) {
      cartPageUpdate(removeBtn.dataset.cartRemove, 0, removeBtn.closest('.cart-item'));
    }
  });

  {%- raw -%}
  function formatMoney(cents) {
    var fmt = (window.Shopify && window.Shopify.money_format) || window.moneyFormat || '{{amount}}';
    var amount = (cents / 100).toFixed(2).replace('.', ',');
    return fmt
      .replace('{{amount_with_comma_separator}}', amount)
      .replace('{{amount_no_decimals_with_comma_separator}}', Math.round(cents / 100).toString())
      .replace('{{amount_no_decimals}}', Math.round(cents / 100).toString())
      .replace('{{amount}}', amount);
  }
  {%- endraw -%}

  function cartPageUpdate(key, qty, itemEl) {
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty < 0 ? 0 : qty })
    })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      if (cart.item_count === 0) { location.reload(); return; }

      var updatedItem = cart.items.find(function (i) { return i.key === key; });

      if (!updatedItem) {
        if (itemEl) itemEl.remove();
      } else {
        var input = itemEl && itemEl.querySelector('.quantity-input');
        if (input) input.value = updatedItem.quantity;
      }

      var formatted = formatMoney(cart.total_price);
      document.querySelectorAll('[data-cart-total]').forEach(function (el) {
        el.textContent = formatted;
      });

      document.querySelectorAll('.cart-count-bubble').forEach(function (el) {
        el.textContent = cart.item_count;
        el.style.display = cart.item_count > 0 ? 'flex' : 'none';
      });
    })
    .catch(function () { location.reload(); });
  }
})();
</script>

{% schema %}
{
  "name": "Carrinho Principal",
  "tag": "section",
  "templates": ["cart"],
  "settings": []
}
{% endschema %}
