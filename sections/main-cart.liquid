<section class="section">
  <div class="page-width">
    <h1 style="margin-bottom:4rem">Carrinho</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page">
        <div class="cart-items">
          <div class="cart-items-header">
            <span>Produto</span>
            <span>Qtd.</span>
            <span>Total</span>
          </div>

          {%- for item in cart.items -%}
            <div class="cart-item" id="cart-item-{{ item.key | replace: ':', '-' }}">
              <div class="cart-item__media">
                <a href="{{ item.url }}">
                  {{
                    item.image
                    | image_url: width: 200
                    | image_tag: loading: 'lazy', width: 200, alt: item.title
                  }}
                </a>
              </div>
              <div class="cart-item__info">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <span class="cart-item__variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-item__price">
                  {%- render 'price', product: item.product, variant: item.variant -%}
                </div>
                <div class="quantity-selector" style="margin-top:0.8rem">
                  <button
                    type="button"
                    class="quantity-btn"
                    onclick="cartUpdate('{{ item.key }}', {{ item.quantity | minus: 1 }})"
                    aria-label="Diminuir quantidade"
                  >−</button>
                  <input
                    class="quantity-input"
                    type="number"
                    value="{{ item.quantity }}"
                    min="1"
                    aria-label="Quantidade"
                    onchange="cartUpdate('{{ item.key }}', parseInt(this.value) || 1)"
                  >
                  <button
                    type="button"
                    class="quantity-btn"
                    onclick="cartUpdate('{{ item.key }}', {{ item.quantity | plus: 1 }})"
                    aria-label="Aumentar quantidade"
                  >+</button>
                </div>
                <button
                  type="button"
                  class="cart-item__remove"
                  onclick="cartUpdate('{{ item.key }}', 0)"
                >Remover</button>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Summary -->
        <div class="cart-summary">
          <h2 class="cart-summary__title">Resumo do Pedido</h2>

          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span>Frete</span>
            <span>Calculado no checkout</span>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Total</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p class="cart-summary__note">
            Impostos e frete calculados no checkout
          </p>

          <a href="/checkout" class="btn btn--primary btn--full">
            Finalizar pedido
          </a>

          <div style="text-align:center;margin-top:1.6rem">
            <a href="{{ routes.root_url }}" style="font-size:1.4rem;text-decoration:underline;color:rgba(var(--color-base-text),0.6)">
              Continuar comprando
            </a>
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <h2 class="cart-empty__title">Seu carrinho está vazio</h2>
        <p class="cart-empty__text">Adicione produtos incríveis ao seu carrinho!</p>
        <a href="{{ routes.root_url }}" class="btn btn--primary">Explorar produtos</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
function cartUpdate(key, qty) {
  fetch('{{ routes.cart_change_url }}', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: key, quantity: qty < 0 ? 0 : qty })
  })
  .then(function(r) { return r.json(); })
  .then(function() { location.reload(); });
}
</script>

{% schema %}
{
  "name": "Carrinho Principal",
  "tag": "section",
  "templates": ["cart"],
  "settings": []
}
{% endschema %}
