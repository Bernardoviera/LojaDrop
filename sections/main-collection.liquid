<div class="collection-hero">
  <div class="page-width">
    <h1 class="collection-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-hero__desc">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

<section class="section">
  <div class="page-width">
    <div class="collection-toolbar">
      <span class="collection-toolbar__count">
        {{ collection.products_count }}
        {%- if collection.products_count == 1 -%} producto{%- else -%} productos{%- endif -%}
      </span>
      <div class="collection-toolbar__sort">
        <label for="sort-select">Ordenar por:</label>
        <select id="sort-select" name="sort_by" class="sort-select" onchange="window.location.href='?sort_by='+this.value">
          <option value="manual"{% if collection.sort_by == 'manual' %} selected{% endif %}>Em destaque</option>
          <option value="best-selling"{% if collection.sort_by == 'best-selling' %} selected{% endif %}>Mais vendidos</option>
          <option value="price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>Menor preço</option>
          <option value="price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>Maior preço</option>
          <option value="created-descending"{% if collection.sort_by == 'created-descending' %} selected{% endif %}>Mais novos</option>
          <option value="title-ascending"{% if collection.sort_by == 'title-ascending' %} selected{% endif %}>A-Z</option>
        </select>
      </div>
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="product-grid" style="--grid-cols:{{ section.settings.columns_desktop }}">
        {%- for product in collection.products -%}
          {%- render 'card-product', product: product -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" style="display:flex;justify-content:center;gap:1rem;margin-top:5rem">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="btn btn--secondary">&lsaquo; Anterior</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="btn btn--secondary">{{ part.title }}</a>
            {%- else -%}
              <span class="btn btn--primary">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="btn btn--secondary">Siguiente &rsaquo;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p style="text-align:center;padding:6rem 0;color:rgba(var(--color-base-text),0.6)">
        No se encontraron productos en esta colección.
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Coleccion Principal",
  "tag": "section",
  "templates": ["collection"],
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columnas en escritorio"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Productos por pagina"
    }
  ]
}
{% endschema %}
