<section class="section image-with-text-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color_val }};">
  <div class="page-width">

    {%- if section.settings.show_logo -%}
      <div class="iwt-logo">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 240
            | image_tag: width: 160, alt: shop.name, class: 'iwt-logo__img'
          }}
        {%- else -%}
          <span class="iwt-logo__text">{{ shop.name }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.image != blank -%}
      <div class="image-with-text{% if section.settings.layout == 'image_second' %} image-with-text--reverse{% endif %}">
        <div class="image-with-text__media">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', width: 900, alt: section.settings.title
          }}
        </div>
        <div class="image-with-text__content">
          {%- if section.settings.eyebrow != blank -%}
            <span class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="image-with-text__title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="image-with-text__text">{{ section.settings.text }}</div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- else -%}
      <div class="image-with-text__content image-with-text__content--centered">
        {%- if section.settings.eyebrow != blank -%}
          <span class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="image-with-text__title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Imagen con Texto",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Fondo y color"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Color de fondo",
      "options": [
        { "value": "#ffffff", "label": "Blanco" },
        { "value": "#f8f5f2", "label": "Crema (suave)" },
        { "value": "#1a1a1a", "label": "Negro elegante" },
        { "value": "#1a1a2e", "label": "Azul oscuro" },
        { "value": "#c9a96e", "label": "Dorado" }
      ],
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "text_color_val",
      "label": "Color del texto",
      "options": [
        { "value": "#ffffff", "label": "Blanco" },
        { "value": "#1a1a1a", "label": "Negro" }
      ],
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Mostrar logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (opcional, si no se sube usa el nombre de la tienda)"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Diseño (con imagen)",
      "options": [
        { "value": "image_first", "label": "Imagen a la izquierda" },
        { "value": "image_second", "label": "Imagen a la derecha" }
      ],
      "default": "image_first"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (opcional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Supertítulo"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Nacimos para hacer brillar a la mujer moderna",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Imagen con Texto"
    }
  ]
}
{% endschema %}
