<footer class="site-footer color-background-2" role="contentinfo">
  <div class="page-width">
    <div class="footer__grid">

      <!-- Brand column -->
      <div class="footer__brand">
        <div class="footer__brand-logo">{{ shop.name }}</div>
        {%- if section.settings.brand_description != blank -%}
          <p class="footer__brand-text">{{ section.settings.brand_description }}</p>
        {%- endif -%}

        {%- if section.settings.show_social -%}
          <div class="footer__social">
            {%- if section.settings.social_instagram != blank -%}
              <a class="footer__social-link" href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_facebook != blank -%}
              <a class="footer__social-link" href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a class="footer__social-link" href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.26 8.26 0 004.83 1.56V6.8a4.85 4.85 0 01-1.06-.11z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if section.settings.social_whatsapp != blank -%}
              <a class="footer__social-link" href="https://wa.me/{{ section.settings.social_whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Link columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h3 class="footer__col-title">{{ block.settings.heading }}</h3>
            <ul class="footer__links">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'text' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h3 class="footer__col-title">{{ block.settings.heading }}</h3>
            <div style="font-size:1.4rem;line-height:1.7;color:rgba(var(--color-base-text),0.65)">
              {{ block.settings.content }}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos os direitos reservados.</span>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment-icons">
          {{ shop.enabled_payment_types | payment_type_svg_tag: class: 'icon icon--full-color' }}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "class": "footer-section",
  "settings": [
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Descrição da marca",
      "default": "Moda e joias com elegância e qualidade. Peças exclusivas para mulheres que valorizam o estilo."
    },
    {
      "type": "header",
      "content": "Redes Sociais"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Mostrar redes sociais"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "social_whatsapp",
      "label": "WhatsApp (apenas números)",
      "placeholder": "5511999999999"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "default": true,
      "label": "Mostrar ícones de pagamento"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu de links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Links rápidos",
          "label": "Título"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Texto",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Informações",
          "label": "Título"
        },
        {
          "type": "richtext",
          "id": "content",
          "default": "<p>Atendimento: Seg-Sex 9h-18h</p><p>contato@lojadrop.com.br</p>",
          "label": "Conteúdo"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Navegação",
          "menu": "main-menu"
        }
      },
      {
        "type": "text",
        "settings": {
          "heading": "Atendimento"
        }
      }
    ]
  }
}
{% endschema %}
