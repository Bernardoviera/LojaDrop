[
  {
    "name": "theme_info",
    "theme_name": "LojaDrop",
    "theme_version": "1.0.0",
    "theme_author": "LojaDrop",
    "theme_documentation_url": "https://lojadrop.com",
    "theme_support_url": "https://lojadrop.com/soporte"
  },
  {
    "name": "Colores",
    "settings": [
      { "type": "color", "id": "colors_text", "default": "#1a1a1a", "label": "Texto principal" },
      { "type": "color", "id": "colors_background_1", "default": "#ffffff", "label": "Fondo principal" },
      { "type": "color", "id": "colors_background_2", "default": "#f8f5f2", "label": "Fondo secundario" },
      { "type": "color", "id": "colors_accent_1", "default": "#c9a96e", "label": "Acento dorado" },
      { "type": "color", "id": "colors_accent_2", "default": "#1a1a1a", "label": "Acento 2" },
      { "type": "color", "id": "colors_solid_button_labels", "default": "#ffffff", "label": "Texto botones solidos" },
      { "type": "color", "id": "colors_outline_button_labels", "default": "#1a1a1a", "label": "Texto botones contorno" },
      { "type": "color_background", "id": "gradient_background_1", "label": "Degradado fondo principal" },
      { "type": "color_background", "id": "gradient_background_2", "label": "Degradado fondo secundario" },
      { "type": "color_background", "id": "gradient_accent_1", "label": "Degradado acento 1" },
      { "type": "color_background", "id": "gradient_accent_2", "label": "Degradado acento 2" }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "default": "playfair_display_n4", "label": "Fuente titulos" },
      { "type": "font_picker", "id": "type_body_font", "default": "lato_n4", "label": "Fuente cuerpo" },
      { "type": "range", "id": "body_scale", "min": 100, "max": 130, "step": 5, "unit": "%", "label": "Tamano fuente cuerpo", "default": 100 },
      { "type": "range", "id": "heading_scale", "min": 100, "max": 150, "step": 5, "unit": "%", "label": "Tamano fuente titulos", "default": 110 }
    ]
  },
  {
    "name": "Diseno",
    "settings": [
      {
        "type": "select", "id": "page_width",
        "options": [
          { "value": "1200", "label": "1200px" },
          { "value": "1400", "label": "1400px" },
          { "value": "1600", "label": "1600px" }
        ],
        "default": "1200", "label": "Ancho maximo de pagina"
      },
      { "type": "range", "id": "spacing_sections", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Espaciado entre secciones", "default": 60 },
      { "type": "range", "id": "spacing_grid_horizontal", "min": 4, "max": 40, "step": 4, "unit": "px", "label": "Espaciado horizontal cuadricula", "default": 24 },
      { "type": "range", "id": "spacing_grid_vertical", "min": 4, "max": 60, "step": 4, "unit": "px", "label": "Espaciado vertical cuadricula", "default": 36 }
    ]
  },
  {
    "name": "Carrito",
    "settings": [
      {
        "type": "select", "id": "cart_type",
        "options": [
          { "value": "drawer", "label": "Cajon lateral" },
          { "value": "page", "label": "Pagina del carrito" }
        ],
        "default": "drawer", "label": "Tipo de carrito"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Imagen 32x32px recomendada" }
    ]
  },
  {
    "name": "WhatsApp",
    "settings": [
      { "type": "text", "id": "whatsapp_number", "label": "Numero de WhatsApp", "placeholder": "34600000000", "info": "Solo numeros con prefijo pais sin el +. Ej: 34600000000" },
      { "type": "checkbox", "id": "whatsapp_show_desktop", "label": "Mostrar en escritorio", "default": true },
      { "type": "checkbox", "id": "whatsapp_show_mobile", "label": "Mostrar en movil", "default": true }
    ]
  },
  {
    "name": "Financiacion",
    "settings": [
      { "type": "checkbox", "id": "parcelamento_enable", "label": "Activar modal de financiacion", "default": true },
      { "type": "range", "id": "max_parcelas", "min": 1, "max": 12, "step": 1, "default": 12, "label": "Maximo de cuotas" },
      { "type": "range", "id": "juros_parcelamento", "min": 0, "max": 5, "step": 1, "default": 0, "label": "Intereses por cuota (%)", "info": "0 = sin intereses" },
      { "type": "checkbox", "id": "show_pix_parcelamento", "label": "Mostrar opcion transferencia en el modal", "default": true },
      { "type": "checkbox", "id": "show_boleto_parcelamento", "label": "Mostrar opcion Bizum en el modal", "default": true },
      { "type": "text", "id": "desconto_pix", "label": "Descuento por transferencia (%)", "default": "5", "info": "Ej: 5 para 5% de descuento" }
    ]
  },
  {
    "name": "Tarjetas producto",
    "settings": [
      { "type": "range", "id": "card_image_padding", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Padding imagen", "default": 0 },
      { "type": "range", "id": "card_corner_radius", "min": 0, "max": 20, "step": 2, "unit": "px", "label": "Radio esquinas", "default": 4 },
      { "type": "select", "id": "card_text_alignment", "options": [{ "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" }], "default": "left", "label": "Alineacion texto" },
      { "type": "range", "id": "card_border_thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Grosor borde", "default": 0 },
      { "type": "range", "id": "card_border_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad borde", "default": 10 },
      { "type": "range", "id": "card_shadow_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad sombra", "default": 0 },
      { "type": "range", "id": "card_shadow_horizontal_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento horizontal sombra", "default": 0 },
      { "type": "range", "id": "card_shadow_vertical_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento vertical sombra", "default": 0 },
      { "type": "range", "id": "card_shadow_blur", "min": 0, "max": 40, "step": 5, "unit": "px", "label": "Desenfoque sombra", "default": 0 }
    ]
  },
  {
    "name": "Botones",
    "settings": [
      { "type": "range", "id": "buttons_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Radio esquinas", "default": 0 },
      { "type": "range", "id": "buttons_border_thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Grosor borde", "default": 2 },
      { "type": "range", "id": "buttons_border_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad borde", "default": 100 },
      { "type": "range", "id": "buttons_shadow_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad sombra", "default": 0 },
      { "type": "range", "id": "buttons_shadow_horizontal_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento horizontal", "default": 0 },
      { "type": "range", "id": "buttons_shadow_vertical_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento vertical", "default": 0 },
      { "type": "range", "id": "buttons_shadow_blur", "min": 0, "max": 40, "step": 5, "unit": "px", "label": "Desenfoque sombra", "default": 0 }
    ]
  },
  {
    "name": "Inputs",
    "settings": [
      { "type": "range", "id": "inputs_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Radio esquinas", "default": 0 },
      { "type": "range", "id": "inputs_border_thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Grosor borde", "default": 1 },
      { "type": "range", "id": "inputs_border_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad borde", "default": 55 },
      { "type": "range", "id": "inputs_shadow_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad sombra", "default": 0 },
      { "type": "range", "id": "inputs_shadow_horizontal_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento horizontal", "default": 0 },
      { "type": "range", "id": "inputs_shadow_vertical_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento vertical", "default": 0 },
      { "type": "range", "id": "inputs_shadow_blur", "min": 0, "max": 40, "step": 5, "unit": "px", "label": "Desenfoque sombra", "default": 0 }
    ]
  },
  {
    "name": "Cajas de texto",
    "settings": [
      { "type": "range", "id": "text_boxes_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Radio esquinas", "default": 8 },
      { "type": "range", "id": "text_boxes_border_thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Grosor borde", "default": 0 },
      { "type": "range", "id": "text_boxes_border_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad borde", "default": 10 },
      { "type": "range", "id": "text_boxes_shadow_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad sombra", "default": 0 },
      { "type": "range", "id": "text_boxes_shadow_horizontal_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento horizontal", "default": 0 },
      { "type": "range", "id": "text_boxes_shadow_vertical_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento vertical", "default": 0 },
      { "type": "range", "id": "text_boxes_shadow_blur", "min": 0, "max": 40, "step": 5, "unit": "px", "label": "Desenfoque sombra", "default": 0 }
    ]
  },
  {
    "name": "Medios",
    "settings": [
      { "type": "range", "id": "media_padding", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Padding", "default": 0 },
      { "type": "range", "id": "media_radius", "min": 0, "max": 20, "step": 2, "unit": "px", "label": "Radio esquinas", "default": 4 },
      { "type": "range", "id": "media_border_thickness", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Grosor borde", "default": 0 },
      { "type": "range", "id": "media_border_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad borde", "default": 10 },
      { "type": "range", "id": "media_shadow_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Opacidad sombra", "default": 0 },
      { "type": "range", "id": "media_shadow_horizontal_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento horizontal", "default": 0 },
      { "type": "range", "id": "media_shadow_vertical_offset", "min": -12, "max": 12, "step": 2, "unit": "px", "label": "Desplazamiento vertical", "default": 0 },
      { "type": "range", "id": "media_shadow_blur", "min": 0, "max": 40, "step": 5, "unit": "px", "label": "Desenfoque sombra", "default": 0 }
    ]
  },
  {
    "name": "Animaciones",
    "settings": [
      {
        "type": "select", "id": "animations_hover_elements",
        "options": [
          { "value": "none", "label": "Ninguno" },
          { "value": "lift", "label": "Elevar" }
        ],
        "default": "lift", "label": "Hover en tarjetas"
      }
    ]
  }
]
