{%- if settings.whatsapp_number != blank -%}
  <a
    href="https://wa.me/55{{ settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '(' | remove: ')' }}"
    class="whatsapp-sticky"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <img
      src="{{ 'VisionWpp.png' | asset_url }}"
      width="54"
      height="54"
      alt="WhatsApp"
      loading="eager"
    >
  </a>

  <style>
    .whatsapp-sticky {
      position: fixed;
      right: 16px;
      bottom: 20px;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      z-index: 9000;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px rgba(37,211,102,0.4);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .whatsapp-sticky:hover {
      transform: scale(1.1);
      box-shadow: 0 6px 24px rgba(37,211,102,0.55);
    }

    @media (max-width: 749px) {
      .whatsapp-sticky {
        bottom: 18px;
        right: 12px;
        width: 50px;
        height: 50px;
      }
    }

    {%- unless settings.whatsapp_show_desktop -%}
      @media (min-width: 750px) { .whatsapp-sticky { display: none !important; } }
    {%- endunless -%}

    {%- unless settings.whatsapp_show_mobile -%}
      @media (max-width: 749px) { .whatsapp-sticky { display: none !important; } }
    {%- endunless -%}
  </style>
{%- endif -%}
